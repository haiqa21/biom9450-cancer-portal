// Helper functions
function h($value) {
    return htmlspecialchars(
        (string) $value,
        ENT_QUOTES,
        'UTF-8'
    );
}

function getAll(PDO $pdo, $sql, $args = []) {
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute($args);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    } catch (Throwable $e) {
        return [];
    }
}

function getCount(PDO $pdo, $sql, $args = []) {
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute($args);
        return (int) $stmt->fetchColumn();
    } catch (Throwable $e) {
        return 0;
    }
}

// Patient directory
$patients = getAll(
    $pdo,
    "SELECT patient_id, first_name, last_name,
            birthdate, sex, country
     FROM patients
     ORDER BY last_name, first_name"
);

$patientCount = count($patients);

// Tasks
$tasks = getAll(
    $pdo,
    "SELECT t.*,
            p.first_name AS pf,
            p.last_name AS pl
     FROM oncologist_tasks t
     LEFT JOIN patients p
        ON p.patient_id = t.patient_id
     WHERE t.user_id = ?
     ORDER BY
        (t.task_status = 'pending') DESC,
        t.due_date IS NULL,
        t.due_date,
        t.created_at DESC",
    [$user_id]
);

// Reviews
$reviews = getAll(
    $pdo,
    "SELECT r.*,
            p.first_name AS pf,
            p.last_name AS pl
     FROM oncologist_reviews r
     LEFT JOIN patients p
        ON p.patient_id = r.patient_id
     WHERE r.user_id = ?
     ORDER BY
        (r.review_status = 'pending') DESC,
        r.created_at DESC",
    [$user_id]
);

// Reports
$reports = getAll(
    $pdo,
    "SELECT r.*,
            p.first_name AS pf,
            p.last_name AS pl
     FROM oncologist_reports r
     LEFT JOIN patients p
        ON p.patient_id = r.patient_id
     WHERE r.user_id = ?
     ORDER BY r.created_at DESC",
    [$user_id]
);

// Appointments
$appointments = getAll(
    $pdo,
    "SELECT a.*,
            p.first_name AS pf,
            p.last_name AS pl
     FROM oncologist_appointments a
     LEFT JOIN patients p
        ON p.patient_id = a.patient_id
     WHERE a.user_id = ?
       AND a.appointment_status = 'scheduled'
     ORDER BY a.appointment_datetime",
    [$user_id]
);

// Recent activity
$activity = getAll(
    $pdo,
    "SELECT action, entity_type, details, created_at
     FROM audit_logs
     WHERE user_id = ?
     ORDER BY created_at DESC
     LIMIT 12",
    [$user_id]
);

// Prediction metrics
$predCount = getCount(
    $pdo,
    "SELECT COUNT(*)
     FROM predictions
     WHERE user_id = ?",
    [$user_id]
);

// Task metrics
$pendingTasks = count(
    array_filter(
        $tasks,
        fn($task) => $task['task_status'] === 'pending'
    )
);

// Review metrics
$pendingReviews = count(
    array_filter(
        $reviews,
        fn($review) => $review['review_status'] === 'pending'
    )
);

// Report metrics
$released = count(
    array_filter(
        $reports,
        fn($report) => $report['report_status'] === 'released'
    )
);

// TCGA metrics
$tcgaCount = getCount(
    $pdo,
    "SELECT COUNT(*) FROM tcga_samples"
);

$passCount = getCount(
    $pdo,
    "SELECT COUNT(*)
     FROM tcga_variants
     WHERE filter_status = 'PASS'"
);

// Prediction analytics
$predictionDist = getAll(
    $pdo,
    "SELECT
        ct.cancer_type,
        AVG(pr.prediction_probability) AS avg_probability,
        COUNT(*) AS n
     FROM prediction_results pr
     JOIN cancer_types ct
        ON ct.cancer_type_id = pr.cancer_type_id
     JOIN predictions p
        ON p.prediction_id = pr.prediction_id
     WHERE p.user_id = ?
     GROUP BY ct.cancer_type
     ORDER BY n DESC
     LIMIT 10",
    [$user_id]
);

// TCGA endpoint
