function h($v) {
    return htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
}

function all(PDO $pdo, string $sql, array $args = []): array {
    try {
        $s = $pdo->prepare($sql);
        $s->execute($args);
        return $s->fetchAll(PDO::FETCH_ASSOC);
    } catch (Throwable $e) {
        return [];
    }
}

function countRows(PDO $pdo, string $sql, array $args = []): int {
    try {
        $s = $pdo->prepare($sql);
        $s->execute($args);
        return (int) $s->fetchColumn();
    } catch (Throwable $e) {
        return 0;
    }
}

// Only patients assigned to this oncologist.
$patients = all($pdo, "
    SELECT p.patient_id, p.first_name, p.last_name, p.birthdate, p.sex, p.country
    FROM patients p
    JOIN oncologist_patients op ON op.patient_id = p.patient_id
    WHERE op.user_id = ?
    ORDER BY p.last_name, p.first_name
", [$user_id]);

$patientCount = count($patients);

$tasks = all($pdo, "
    SELECT t.*, p.first_name AS pf, p.last_name AS pl
    FROM oncologist_tasks t
    LEFT JOIN patients p ON p.patient_id = t.patient_id
    WHERE t.user_id = ?
    AND (
        t.patient_id IS NULL
        OR EXISTS (
            SELECT 1
            FROM oncologist_patients op
            WHERE op.user_id = ?
            AND op.patient_id = t.patient_id
        )
    )
    ORDER BY (t.task_status = 'pending') DESC,
             t.due_date IS NULL,
             t.due_date,
             t.created_at DESC
", [$user_id, $user_id]);

$appointments = all($pdo, "
    SELECT a.*, p.first_name AS pf, p.last_name AS pl
    FROM oncologist_appointments a
    LEFT JOIN patients p ON p.patient_id = a.patient_id
    WHERE a.user_id = ?
    AND a.appointment_status = 'scheduled'
    AND a.appointment_datetime >= NOW()
    AND (
        a.patient_id IS NULL
        OR EXISTS (
            SELECT 1
            FROM oncologist_patients op
            WHERE op.user_id = ?
            AND op.patient_id = a.patient_id
        )
    )
    ORDER BY a.appointment_datetime
    LIMIT 8
", [$user_id, $user_id]);

$reports = all($pdo, "
    SELECT r.*, p.first_name AS pf, p.last_name AS pl
    FROM oncologist_reports r
    JOIN patients p ON p.patient_id = r.patient_id
    JOIN oncologist_patients op
        ON op.patient_id = r.patient_id
        AND op.user_id = r.user_id
    WHERE r.user_id = ?
    ORDER BY r.created_at DESC
    LIMIT 8
", [$user_id]);

$activity = all($pdo, "
    SELECT action, entity_type, details, created_at
    FROM audit_logs
