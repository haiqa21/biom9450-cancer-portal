// --------------------------------------------------
// Helper functions
// --------------------------------------------------

function h($value) {
    return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
}

function all(PDO $pdo, string $sql, array $args = []): array {
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute($args);

        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    } catch (Throwable $e) {
        return [];
    }
}

function countRows(PDO $pdo, string $sql, array $args = []): int {
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute($args);

        return (int) $stmt->fetchColumn();
    } catch (Throwable $e) {
        return 0;
    }
}

// --------------------------------------------------
// Patient data
// Only patients assigned to this oncologist.
// --------------------------------------------------

$patients = all($pdo, "
    SELECT
        p.patient_id,
        p.first_name,
        p.last_name,
        p.birthdate,
        p.sex,
        p.country
    FROM patients p
    JOIN oncologist_patients op
        ON op.patient_id = p.patient_id
    WHERE op.user_id = ?
    ORDER BY p.last_name, p.first_name
", [$user_id]);

$patientCount = count($patients);

// --------------------------------------------------
// Tasks
// --------------------------------------------------

$tasks = all($pdo, "
    SELECT
        t.*,
        p.first_name AS pf,
        p.last_name AS pl
    FROM oncologist_tasks t
    LEFT JOIN patients p
        ON p.patient_id = t.patient_id
    WHERE t.user_id = ?
    ORDER BY
        (t.task_status = 'pending') DESC,
        t.due_date IS NULL,
        t.due_date,
        t.created_at DESC
", [$user_id]);

$pendingTasks = count(
    array_filter(
        $tasks,
        fn($t) => $t['task_status'] === 'pending'
    )
);

// --------------------------------------------------
// Upcoming appointments
// --------------------------------------------------

$appointments = all($pdo, "
    SELECT
        a.*,
        p.first_name AS pf,
        p.last_name AS pl
    FROM oncologist_appointments a
    LEFT JOIN patients p
        ON p.patient_id = a.patient_id
    WHERE a.user_id = ?
      AND a.appointment_status = 'scheduled'
      AND a.appointment_datetime >= NOW()
    ORDER BY a.appointment_datetime
    LIMIT 8
", [$user_id]);

$scheduledCount = countRows($pdo, "
    SELECT COUNT(*)
    FROM oncologist_appointments
    WHERE user_id = ?
      AND appointment_status = 'scheduled'
      AND appointment_datetime >= NOW()
", [$user_id]);

// --------------------------------------------------
// Reports
// --------------------------------------------------

$reports = all($pdo, "
    SELECT
        r.*,
        p.first_name AS pf,
        p.last_name AS pl
    FROM oncologist_reports r
    LEFT JOIN patients p
        ON p.patient_id = r.patient_id
    WHERE r.user_id = ?
    ORDER BY r.created_at DESC
    LIMIT 8
", [$user_id]);

$draftReports = count(
    array_filter(
        $reports,
        fn($r) => $r['report_status'] === 'draft'
    )
);

$releasedReports = countRows($pdo, "
    SELECT COUNT(*)
    FROM oncologist_reports
    WHERE user_id = ?
      AND report_status = 'released'
", [$user_id]);

// --------------------------------------------------
// Recent activity
// --------------------------------------------------

$activity = all($pdo, "
    SELECT
        action,
        entity_type,
        details,
        created_at
    FROM audit_logs
    WHERE user_id = ?
    ORDER BY created_at DESC
    LIMIT 8
", [$user_id]);

