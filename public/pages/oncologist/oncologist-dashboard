<!-- CHART.JS -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

// Patient directory search

const patientSearch = document.getElementById('patientSearch');

patientSearch?.addEventListener('input', () => {

    const q = patientSearch.value.toLowerCase();

    document.querySelectorAll('#patientRows tr').forEach(row => {

        row.hidden = !row.innerText.toLowerCase().includes(q);

    });

});


// Prediction chart

const predictionData = <?= json_encode(
    $predictionDist,
    JSON_HEX_TAG |
    JSON_HEX_APOS |
    JSON_HEX_QUOT |
    JSON_HEX_AMP
) ?>;


if (predictionData.length) {

    new Chart(
        document.getElementById('predictionChart'),
        {

            type: 'bar',

            data: {

                labels: predictionData.map(
                    item => item.cancer_type
                ),

                datasets: [{

                    label: 'Average prediction probability',

                    data: predictionData.map(
                        item => Number(item.avg_probability)
                    ),

                    backgroundColor: '#648B83'

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                scales: {

                    y: {

                        beginAtZero: true,
                        max: 1

                    }

                }

            }

        }
    );

}


// TCGA charts

async function loadTCGA() {

    try {

        const response = await fetch(
            'tcga-dashboard-data.php'
        );

        if (!response.ok) {
            throw new Error('TCGA endpoint failed');
        }

        const data = await response.json();


        // Samples by cancer type

        const sampleData =
            data.cancer_distribution.slice(0, 10);


        new Chart(
            document.getElementById('sampleChart'),
            {

                type: 'bar',

                data: {

                    labels: sampleData.map(
                        item => item.cancer_type
                    ),

                    datasets: [{

                        label: 'Samples',

                        data: sampleData.map(
                            item => Number(item.sample_count)
                        ),

                        backgroundColor: '#648B83'

                    }]

                },

                options: {

                    indexAxis: 'y',

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        }

                    }

                }

            }
        );


        // PASS variants by cancer type

        const passData =
            data.pass_distribution.slice(0, 10);


        new Chart(
            document.getElementById('passChart'),
            {

                type: 'bar',

                data: {

                    labels: passData.map(
                        item => item.cancer_type
                    ),

                    datasets: [{

                        label: 'PASS variants',

                        data: passData.map(
                            item => Number(item.pass_count)
                        ),

                        backgroundColor: '#7895B2'

                    }]

                },

                options: {

                    indexAxis: 'y',

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        }

                    }

                }

            }
        );


        // PASS and non-PASS variants

        const pass = data.variant_quality
            .filter(item => item.filter_status === 'PASS')
            .reduce(
                (sum, item) => sum + Number(item.variant_count),
                0
            );

        const nonPass = data.variant_quality
            .filter(item => item.filter_status !== 'PASS')
            .reduce(
                (sum, item) => sum + Number(item.variant_count),
                0
            );


        new Chart(
            document.getElementById('qualityChart'),
            {

                type: 'doughnut',

                data: {

                    labels: ['PASS', 'Non-PASS'],

                    datasets: [{

                        data: [pass, nonPass],

                        backgroundColor: [
                            '#648B83',
                            '#D7A878'
                        ],

                        borderWidth: 0

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: '70%'

                }

            }
        );

    } catch (error) {

        console.error('TCGA charts:', error);

    }

}

<?php if ($tcgaDataAvailable): ?>

    loadTCGA();

<?php endif; ?>

</script>

