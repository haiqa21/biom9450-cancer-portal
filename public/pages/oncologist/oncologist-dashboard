$draftReports = countRows($pdo, "
    SELECT COUNT(*)
    FROM oncologist_reports r
    JOIN oncologist_patients op
        ON op.patient_id = r.patient_id
        AND op.user_id = r.user_id
    WHERE r.user_id = ?
    AND r.report_status = 'draft'
", [$user_id]);

$releasedReports = countRows($pdo, "
    SELECT COUNT(*)
    FROM oncologist_reports r
    JOIN oncologist_patients op
        ON op.patient_id = r.patient_id
        AND op.user_id = r.user_id
    WHERE r.user_id = ?
    AND r.report_status = 'released'
", [$user_id]);

$scheduledCount = countRows($pdo, "
    SELECT COUNT(*)
