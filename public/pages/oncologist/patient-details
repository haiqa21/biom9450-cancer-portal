<?php
session_start();
require_once __DIR__ . '/../../includes/db.php';

// Authentication
if (!isset($_SESSION['user_id'], $_SESSION['role']) || $_SESSION['role'] !== 'oncologist') {
    header('Location: ../login.php');
    exit;
}
$user_id = (int) $_SESSION['user_id'];

// Accept both parameter names: dashboard uses patient_id; older links may use id.
$rawPatientId = $_GET['patient_id'] ?? $_GET['id'] ?? $_POST['patient_id'] ?? $_POST['id'] ?? null;
$patient_id = filter_var($rawPatientId, FILTER_VALIDATE_INT);
if (!$patient_id || $patient_id < 1) {
    http_response_code(400);
    exit('Invalid patient ID.');
}

function h($value): string {
    return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES, 'UTF-8');
}
function formatDate($date): string {
    if (!$date) return 'Not recorded';
    $timestamp = strtotime((string)$date);
    return $timestamp ? date('d M Y', $timestamp) : 'Not recorded';
}
function consentLabel($consent): string {
    return $consent ? ucfirst((string)$consent['consent_status']) : 'Not recorded';
}

// CSRF token
if (empty($_SESSION['csrf'])) {
    $_SESSION['csrf'] = bin2hex(random_bytes(32));
}
$csrf = $_SESSION['csrf'];
$assessmentError = '';
$assessmentMessage = '';

try {
    // Verify patient assignment BEFORE any patient-specific operation or POST handling.
    $stmt = $pdo->prepare("SELECT p.* FROM patients p
        INNER JOIN oncologist_patients op ON op.patient_id = p.patient_id
        WHERE p.patient_id = ? AND op.user_id = ? AND op.assignment_status = 'active'
        LIMIT 1");
    $stmt->execute([$patient_id, $user_id]);
    $patient = $stmt->fetch(PDO::FETCH_ASSOC);
    if (!$patient) {
        http_response_code(404);
        exit('Patient not found or you do not have permission to access this patient.');
    }

    // Retrieve latest consent record per consent type.
    $stmt = $pdo->prepare("SELECT pc.* FROM patient_consents pc
        INNER JOIN (SELECT consent_type, MAX(consent_id) AS latest_id
            FROM patient_consents WHERE patient_id = ? GROUP BY consent_type) latest
        ON pc.consent_id = latest.latest_id ORDER BY pc.consent_type");
    $stmt->execute([$patient_id]);
    $consentRows = $stmt->fetchAll(PDO::FETCH_ASSOC);
    $consents = ['ai_processing' => null, 'research' => null];
    foreach ($consentRows as $consent) {
        if (array_key_exists($consent['consent_type'], $consents)) {
            $consents[$consent['consent_type']] = $consent;
        }
    }

    // Current oncologist's latest independent assessment, if any.
    $stmt = $pdo->prepare("SELECT ca.*, ct.cancer_name, ct.cancer_code,
            prof.first_name, prof.last_name
        FROM clinician_assessments ca
        INNER JOIN cancer_types ct ON ct.cancer_type_id = ca.cancer_type_id
        INNER JOIN professionals prof ON prof.user_id = ca.user_id
        WHERE ca.patient_id = ? AND ca.user_id = ?
        ORDER BY ca.created_at DESC LIMIT 1");
    $stmt->execute([$patient_id, $user_id]);
    $myLatestAssessment = $stmt->fetch(PDO::FETCH_ASSOC);
    $hasAssessment = (bool)$myLatestAssessment;

    // Handle independent clinical assessment submission.
    if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['submit_assessment'])) {
        $postedCsrf = $_POST['csrf'] ?? '';
        if (!is_string($postedCsrf) || !hash_equals($_SESSION['csrf'], $postedCsrf)) {
            $assessmentError = 'Invalid form session. Please refresh and try again.';
        } elseif ($hasAssessment) {
            $assessmentError = 'You have already recorded an initial assessment for this patient. Review it below.';
        } else {
            $cancer_type_id = filter_var($_POST['cancer_type_id'] ?? null, FILTER_VALIDATE_INT);
            $assessment_reasoning = trim((string)($_POST['assessment_reasoning'] ?? ''));
            $supporting_findings = trim((string)($_POST['supporting_findings'] ?? ''));

            if (!$cancer_type_id || $cancer_type_id < 1) {
                $assessmentError = 'Please select a cancer type.';
            } elseif ($assessment_reasoning === '') {
                $assessmentError = 'Please enter your clinical reasoning.';
            } else {
                $check = $pdo->prepare('SELECT cancer_type_id FROM cancer_types WHERE cancer_type_id = ?');
                $check->execute([$cancer_type_id]);
                if (!$check->fetchColumn()) {
                    $assessmentError = 'The selected cancer type is invalid.';
                } else {
                    // Re-check assignment and prevent duplicate initial assessment at write time.
                    $assignmentCheck = $pdo->prepare("SELECT 1 FROM oncologist_patients
                        WHERE user_id = ? AND patient_id = ? AND assignment_status = 'active' LIMIT 1");
                    $assignmentCheck->execute([$user_id, $patient_id]);
                    if (!$assignmentCheck->fetchColumn()) {
                        http_response_code(403);
                        exit('You are not assigned to this patient.');
                    }
                    $duplicateCheck = $pdo->prepare('SELECT 1 FROM clinician_assessments WHERE patient_id = ? AND user_id = ? LIMIT 1');
                    $duplicateCheck->execute([$patient_id, $user_id]);
                    if ($duplicateCheck->fetchColumn()) {
                        $assessmentError = 'An initial assessment already exists. Refresh this page to view it.';
                    } else {
                        $insert = $pdo->prepare("INSERT INTO clinician_assessments
                            (patient_id, user_id, cancer_type_id, assessment_reasoning, supporting_findings)
                            VALUES (?, ?, ?, ?, ?)");
                        $insert->execute([$patient_id, $user_id, $cancer_type_id, $assessment_reasoning,
                            $supporting_findings !== '' ? $supporting_findings : null]);
                        header('Location: patient-details.php?patient_id=' . $patient_id . '&assessment=saved');
                        exit;
                    }
                }
            }
        }
    }
    if (($_GET['assessment'] ?? '') === 'saved') {
        $assessmentMessage = 'Clinical assessment saved successfully.';
    }

    // Age (birthdate may be null).
    $age = null;
    if (!empty($patient['birthdate'])) {
        try { $age = (new DateTime($patient['birthdate']))->diff(new DateTime())->y; }
        catch (Throwable $e) { $age = null; }
    }

    // Cancer types available for assessment.
    $cancerTypes = $pdo->query('SELECT cancer_type_id, cancer_name, cancer_code FROM cancer_types ORDER BY cancer_name')->fetchAll(PDO::FETCH_ASSOC);

    // Diagnoses
    $stmt = $pdo->prepare("SELECT d.*, ct.cancer_name, ct.cancer_code FROM patient_diagnoses d
        INNER JOIN cancer_types ct ON ct.cancer_type_id = d.cancer_type_id
        WHERE d.patient_id = ? ORDER BY d.date_of_diagnosis DESC");
    $stmt->execute([$patient_id]);
    $diagnoses = $stmt->fetchAll(PDO::FETCH_ASSOC);

    // Treatments
    $stmt = $pdo->prepare("SELECT t.*, d.cancer_type_id FROM patient_treatments t
        INNER JOIN patient_diagnoses d ON d.diagnosis_id = t.diagnosis_id
        WHERE d.patient_id = ? ORDER BY t.start_date DESC");
    $stmt->execute([$patient_id]);
    $treatments = $stmt->fetchAll(PDO::FETCH_ASSOC);

    // Samples
    $stmt = $pdo->prepare('SELECT * FROM samples WHERE patient_id = ? ORDER BY date_detected DESC');
    $stmt->execute([$patient_id]);
    $samples = $stmt->fetchAll(PDO::FETCH_ASSOC);

    // Mutation details for patient's samples.
    $stmt = $pdo->prepare("SELECT pm.sample_id, pm.allele_frequency, m.mutation_id,
            m.genomic_position, m.original_allele, m.altered_allele, m.mutation_type,
            m.clinical_significance, m.genome_assembly, g.gene_symbol, g.chromosome
        FROM patient_mutations pm
        INNER JOIN mutations m ON m.mutation_id = pm.mutation_id
        INNER JOIN genes g ON g.gene_id = m.gene_id
        INNER JOIN samples s ON s.sample_id = pm.sample_id
        WHERE s.patient_id = ? ORDER BY s.sample_id, g.gene_symbol");
    $stmt->execute([$patient_id]);
    $mutationRows = $stmt->fetchAll(PDO::FETCH_ASSOC);
    $mutationsBySample = [];
    foreach ($mutationRows as $mutation) $mutationsBySample[$mutation['sample_id']][] = $mutation;

    // Assessment history for this patient (across assigned clinicians).
    $stmt = $pdo->prepare("SELECT ca.assessment_id, ca.assessment_reasoning, ca.supporting_findings,
            ca.created_at, ct.cancer_name, ct.cancer_code, prof.first_name, prof.last_name
        FROM clinician_assessments ca INNER JOIN cancer_types ct ON ct.cancer_type_id = ca.cancer_type_id
        INNER JOIN professionals prof ON prof.user_id = ca.user_id
        WHERE ca.patient_id = ? ORDER BY ca.created_at DESC");
    $stmt->execute([$patient_id]);
    $clinicalAssessments = $stmt->fetchAll(PDO::FETCH_ASSOC);

    // AI results are only queried/displayed if the latest AI consent is granted AND
    // this oncologist has recorded an independent assessment.
    $aiConsentGranted = $consents['ai_processing'] && $consents['ai_processing']['consent_status'] === 'granted';
    $aiPredictions = [];
    if ($aiConsentGranted && $hasAssessment) {
        $stmt = $pdo->prepare("SELECT p.prediction_id, p.model_used, p.created_at,
                ct.cancer_name, ct.cancer_code, pr.prediction_probability
            FROM predictions p INNER JOIN prediction_results pr ON pr.prediction_id = p.prediction_id
            INNER JOIN cancer_types ct ON ct.cancer_type_id = pr.cancer_type_id
            WHERE p.patient_id = ? ORDER BY p.created_at DESC, pr.prediction_probability DESC");
        $stmt->execute([$patient_id]);
        $aiPredictions = $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

} catch (PDOException $e) {
    error_log('Patient details error: ' . $e->getMessage());
    http_response_code(500);
    exit('Unable to load patient details. Please try again later.');
}
?>
