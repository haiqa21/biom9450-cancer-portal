            <div><span>Full Name</span><strong><?= h($patient['first_name'] . ' ' . $patient['last_name']) ?></strong></div>
            <div><span>Age</span><strong><?= $age !== null ? h($age) . ' years' : 'Not recorded' ?></strong></div>
            <div><span>Date of Birth</span><strong><?= h(formatDate($patient['birthdate'])) ?></strong></div>
            <div><span>Sex</span><strong><?= h(ucfirst($patient['sex'] ?? 'Not recorded')) ?></strong></div>
            <div><span>Country</span><strong><?= h($patient['country'] ?? 'Not recorded') ?></strong></div>
            <div><span>Patient ID</span><strong><?= h($patient['patient_id']) ?></strong></div>
        </div>
    </section>

    <section class="details-section">
        <h2>Diagnoses</h2>
        <?php if (!$diagnoses): ?><p>No diagnoses recorded.</p><?php else: ?>
            <?php foreach ($diagnoses as $diagnosis): ?>
                <article class="record-card"><h3><?= h($diagnosis['cancer_name']) ?></h3>
                    <p>TCGA code: <strong><?= h($diagnosis['cancer_code']) ?></strong></p>
                    <div class="details-grid">
                        <div><span>Date of Diagnosis</span><strong><?= h(formatDate($diagnosis['date_of_diagnosis'])) ?></strong></div>
                        <div><span>Stage</span><strong><?= h($diagnosis['stage'] ?? 'Not recorded') ?></strong></div>
                        <div><span>Status</span><strong><?= h(ucfirst($diagnosis['status'] ?? 'Not recorded')) ?></strong></div>
                    </div>
                    <h4>Treatment History</h4>
                    <?php $diagnosisTreatments = array_filter($treatments, fn($t) => $t['diagnosis_id'] == $diagnosis['diagnosis_id']); ?>
                    <?php if (!$diagnosisTreatments): ?><p>No treatments recorded.</p><?php else: ?>
                        <?php foreach ($diagnosisTreatments as $treatment): ?>
                            <div class="record-item"><strong><?= h($treatment['treatment_type']) ?></strong>
                                <p><?= h($treatment['treatment_description'] ?: 'No description recorded.') ?></p>
                                <p><?= h(formatDate($treatment['start_date'])) ?> – <?= h(formatDate($treatment['end_date'])) ?></p>
                                <span><?= h(ucfirst($treatment['status'] ?? 'Not recorded')) ?></span></div>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </article>
            <?php endforeach; ?>
        <?php endif; ?>
    </section>

    <section class="details-section"><h2>Genetic Samples and Mutations</h2>
        <?php if (!$samples): ?><p>No genetic samples recorded.</p><?php else: ?>
            <?php foreach ($samples as $sample): ?><article class="record-card"><h3>Sample: <?= h($sample['sample_code']) ?></h3><p>Date detected: <?= h(formatDate($sample['date_detected'])) ?></p>
                <?php $sampleMutations = $mutationsBySample[$sample['sample_id']] ?? []; ?>
                <?php if (!$sampleMutations): ?><p>No mutations recorded for this sample.</p><?php else: ?>
                    <div class="table-wrapper"><table><thead><tr><th>Gene</th><th>Chromosome</th><th>Position</th><th>Mutation</th><th>Type</th><th>Clinical Significance</th><th>Allele Frequency</th></tr></thead><tbody>
                        <?php foreach ($sampleMutations as $mutation): ?><tr>
                            <td><?= h($mutation['gene_symbol']) ?></td><td><?= h($mutation['chromosome']) ?></td><td><?= h($mutation['genomic_position']) ?></td>
                            <td><?= h($mutation['original_allele'] ?? '-') ?> &rarr; <?= h($mutation['altered_allele'] ?? '-') ?></td><td><?= h($mutation['mutation_type']) ?></td>
                            <td><?= h(ucwords(str_replace('_', ' ', $mutation['clinical_significance'] ?? 'Not recorded'))) ?></td>
                            <td><?= $mutation['allele_frequency'] !== null ? h(number_format((float)$mutation['allele_frequency'] * 100, 2)) . '%' : 'Not recorded' ?></td>
                        </tr><?php endforeach; ?></tbody></table></div>
                <?php endif; ?></article>
            <?php endforeach; ?>
        <?php endif; ?>
    </section>

    <section class="details-section"><h2>Patient Consent</h2><div class="details-grid">
        <div><span>AI Processing Consent</span><strong><?= h(consentLabel($consents['ai_processing'])) ?></strong><?php if ($consents['ai_processing']): ?><p>Recorded: <?= h(formatDate($consents['ai_processing']['recorded_at'] ?? null)) ?></p><?php endif; ?></div>
        <div><span>Research Consent</span><strong><?= h(consentLabel($consents['research'])) ?></strong><?php if ($consents['research']): ?><p>Recorded: <?= h(formatDate($consents['research']['recorded_at'] ?? null)) ?></p><?php endif; ?></div>
    </div></section>

    <section class="details-section"><h2>Clinical Assessment</h2>
        <p>Record your independent clinical assessment before reviewing any AI-generated predictions.</p>
        <?php if ($assessmentMessage): ?><p class="success-message"><?= h($assessmentMessage) ?></p><?php endif; ?>
        <?php if ($assessmentError): ?><p class="error-message"><?= h($assessmentError) ?></p><?php endif; ?>
        <?php if ($myLatestAssessment): ?>
            <article class="record-card"><h3>Your initial assessment</h3><p><strong>Suspected cancer type:</strong> <?= h($myLatestAssessment['cancer_name']) ?> (<?= h($myLatestAssessment['cancer_code']) ?>)</p>
                <p><strong>Recorded:</strong> <?= h(formatDate($myLatestAssessment['created_at'])) ?></p><p><strong>Clinical reasoning:</strong></p><p><?= nl2br(h($myLatestAssessment['assessment_reasoning'])) ?></p>
                <p><strong>Supporting findings:</strong></p><p><?= nl2br(h($myLatestAssessment['supporting_findings'] ?: 'None recorded.')) ?></p></article>
            <p>Your initial assessment has been recorded. The assessment form is locked to preserve the independent assessment step.</p>
        <?php else: ?>
            <form method="POST" action="patient-details.php?patient_id=<?= (int)$patient_id ?>">
                <input type="hidden" name="patient_id" value="<?= (int)$patient_id ?>"><input type="hidden" name="csrf" value="<?= h($csrf) ?>">
                <div><label for="cancer_type_id">Suspected cancer type</label><select name="cancer_type_id" id="cancer_type_id" required><option value="">Select cancer type</option>
                    <?php foreach ($cancerTypes as $type): ?><option value="<?= (int)$type['cancer_type_id'] ?>"><?= h($type['cancer_name']) ?> (<?= h($type['cancer_code']) ?>)</option><?php endforeach; ?></select></div>
                <div><label for="assessment_reasoning">Clinical reasoning</label><textarea name="assessment_reasoning" id="assessment_reasoning" rows="5" required placeholder="Explain your independent clinical assessment..."></textarea></div>
                <div><label for="supporting_findings">Supporting findings</label><textarea name="supporting_findings" id="supporting_findings" rows="4" placeholder="Record relevant symptoms, test results, mutation findings or other evidence..."></textarea></div>
                <button type="submit" name="submit_assessment" value="1" class="ci-button">Save Clinical Assessment</button>
            </form>
        <?php endif; ?>
    </section>

    <section class="details-section"><h2>Clinical Assessment History</h2>
        <?php if (!$clinicalAssessments): ?><p>No clinical assessments have been recorded.</p><?php else: ?>
            <?php foreach ($clinicalAssessments as $assessment): ?><article class="record-card"><h3><?= h($assessment['cancer_name']) ?> (<?= h($assessment['cancer_code']) ?>)</h3><p><strong>Clinician:</strong> <?= h($assessment['first_name'] . ' ' . $assessment['last_name']) ?></p><p><strong>Recorded:</strong> <?= h(formatDate($assessment['created_at'])) ?></p><p><strong>Reasoning:</strong></p><p><?= nl2br(h($assessment['assessment_reasoning'])) ?></p><p><strong>Supporting findings:</strong></p><p><?= nl2br(h($assessment['supporting_findings'] ?: 'None recorded.')) ?></p></article><?php endforeach; ?>
        <?php endif; ?>
    </section>

    <section class="details-section"><h2>AI Prediction Results</h2>
        <?php if (!$aiConsentGranted): ?><p>AI predictions are unavailable because the latest AI-processing consent record is not marked as granted. AI processing consent is separate from research consent.</p>
        <?php elseif (!$hasAssessment): ?><p>Record your independent clinical assessment before AI prediction results are displayed.</p>
        <?php elseif (!$aiPredictions): ?><p>No AI predictions have been generated for this patient yet.</p>
        <?php else: ?><p>AI-generated results are shown for review and are not a substitute for clinical judgement.</p>
            <?php foreach ($aiPredictions as $prediction): ?><article class="record-card"><h3><?= h($prediction['cancer_name']) ?> (<?= h($prediction['cancer_code']) ?>)</h3><p><strong>Probability:</strong> <?= h(number_format((float)$prediction['prediction_probability'] * 100, 2)) ?>%</p><p><strong>Model:</strong> <?= h($prediction['model_used']) ?></p><p><strong>Generated:</strong> <?= h(formatDate($prediction['created_at'])) ?></p></article><?php endforeach; ?>
        <?php endif; ?>
    </section>
    <p class="note">CancerInsight is a research and workflow prototype. Information shown is not a substitute for clinical judgement.</p>
</main>
</body>
</html>

