    <header class="patient-header">
        <div><p class="eyebrow">PATIENT RECORD</p><h1><?= h($patient['first_name'] . ' ' . $patient['last_name']) ?></h1><p>Patient ID: <?= h($patient['patient_id']) ?></p></div>
    </header>

    <section class="details-section">
        <h2>Personal Information</h2>
